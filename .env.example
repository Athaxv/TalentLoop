# ============================================================================
# TalentLoop — Switch-Powered Multi-Agent Job Search Platform
# ============================================================================

# 1. Database & Auth
TALENTLOOP_DB_PATH=./.talentloop/talentloop.sqlite
TALENTLOOP_ADMIN_SECRET=tl_secret_change_me_in_production_32chars

# 2. Switch Server Configuration (https://docs.switchagents.ai)
# Point to your Switch Core server (default port 8000) or embedded Switch protocol server
SWITCH_SERVER_URL=http://127.0.0.1:8400
AGENT_REGISTRATION_TOKEN=switch_reg_bootstrap_token_talentloop_2026
SWITCH_ROOM_NAME=talentloop-job-search
SWITCH_BRIDGE_NAME=Slack

# 3. Slack Integration (Switch Bridge + Direct Slack Web API / Events)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-level-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_WORKSPACE_ID=T0000000000
SLACK_DEFAULT_CHANNEL_ID=C0000000000

# 4. Local Browser Companion & crawlJob Integration
CRAWLJOB_REPO_PATH=D:\Learning\LLD\smallJobs\crawlJob
CRAWLJOB_PROFILE_PATH=D:\Learning\LLD\smallJobs\crawlJob\.crawljob\profile.json
APPLICATION_AGENT_MODE=review
COMPANION_POLL_INTERVAL_MS=3000

# 5. LLM Provider (Optional — Groq / OpenAI for enhanced parsing & required-field drafting)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 6. Gmail OAuth2 Configuration (Agent 6: Pip)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
